+func (suite *TrackListInternalSuite) TestJumpToNextDJSegmentAcrossPages() {
+	pageOne := []*connectpb.ContextTrack{
+		{Uri: trackUri(0), Metadata: map[string]string{"segment": "one", "dj.jump_target": "true"}},
+		{Uri: trackUri(1), Metadata: map[string]string{"segment": "one"}},
+	}
+	pageTwo := []*connectpb.ContextTrack{
+		{Uri: trackUri(2), Metadata: map[string]string{"segment": "one", "dj.jump_target": "true"}},
+		{Uri: trackUri(3), Metadata: map[string]string{"segment": "two", "dj.jump_target": "true"}},
+		{Uri: trackUri(4), Metadata: map[string]string{"segment": "two"}},
+	}
+	suite.resolver.EXPECT().Page(mock.Anything, 0).Return(pageOne, nil)
+	suite.resolver.EXPECT().Page(mock.Anything, 1).Return(pageTwo, nil)
+	ctx := context.Background()
+	suite.Require().True(suite.list.GoStart(ctx))
+
+	suite.Require().NoError(suite.list.JumpToNextDJSegment(ctx))
+	suite.Equal(trackUri(3), suite.list.CurrentTrack().Uri)
+	suite.Require().True(suite.list.GoNext(ctx))
+	suite.Equal(trackUri(4), suite.list.CurrentTrack().Uri)
+}
+
+func (suite *TrackListInternalSuite) TestJumpWithoutTargetKeepsCurrentTrack() {
+	page := []*connectpb.ContextTrack{
+		{Uri: trackUri(0), Metadata: map[string]string{"segment": "one", "dj.jump_target": "true"}},
+		{Uri: trackUri(1), Metadata: map[string]string{"segment": "one"}},
+	}
+	suite.resolver.EXPECT().Page(mock.Anything, 0).Return(page, nil)
+	suite.resolver.EXPECT().Page(mock.Anything, 1).Return(nil, io.EOF)
+	ctx := context.Background()
+	suite.Require().True(suite.list.GoStart(ctx))
+
+	suite.Error(suite.list.JumpToNextDJSegment(ctx))
+	suite.Equal(trackUri(0), suite.list.CurrentTrack().Uri)
+	suite.Require().True(suite.list.GoNext(ctx))
+	suite.Equal(trackUri(1), suite.list.CurrentTrack().Uri)
+}
