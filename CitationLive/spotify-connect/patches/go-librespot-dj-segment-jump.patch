+// JumpToNextDJSegment moves to the first track of the next DJ segment.
+// Only a successful lookup changes the current track or consumes a queue entry.
+func (tl *List) JumpToNextDJSegment(ctx context.Context) error {
+	if tl.tracks.pos < 0 {
+		return fmt.Errorf("no active DJ track list")
+	}
+
+	currentSegment := tl.tracks.get().item.GetMetadata()["segment"]
+	iter := tl.tracks.iterHere()
+	for iter.next(ctx) {
+		metadata := iter.get().item.GetMetadata()
+		if metadata["dj.jump_target"] != "true" ||
+			(currentSegment != "" && metadata["segment"] == currentSegment) {
+			continue
+		}
+
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		tl.tracks.move(iter)
+		if tl.playingQueue {
+			tl.queue = tl.queue[1:]
+			tl.playingQueue = false
+		}
+		return nil
+	}
+	if err := iter.error(); err != nil {
+		return fmt.Errorf("fetching next DJ segment: %w", err)
+	}
+	return fmt.Errorf("no next DJ segment")
+}
+
