diff --git a/daemon/dj_segment_jump.go b/daemon/dj_segment_jump.go
new file mode 100644
index 0000000..97710ea
--- /dev/null
+++ b/daemon/dj_segment_jump.go
@@ -0,0 +1,48 @@
+package daemon
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/devgianlu/go-librespot/tracks"
+)
+
+func (p *AppPlayer) jumpDJSegment() error {
+	if p.state.player.GetContextMetadata()["lexicon_set_type"] != "your_dj" ||
+		p.state.tracks == nil || !p.state.active {
+		return fmt.Errorf("no active DJ context")
+	}
+	if p.loadInFlight || p.state.player.IsBuffering {
+		return fmt.Errorf("DJ track is still loading")
+	}
+
+	delay := p.noteSkip()
+	p.loadGen++
+	p.listJob("next DJ segment", classLoad, nil,
+		func(ctx context.Context, list *tracks.List) error {
+			ctx, cancel := context.WithTimeout(ctx, 8*time.Second)
+			defer cancel()
+			return list.JumpToNextDJSegment(ctx)
+		},
+		func(p *AppPlayer, snap *tracks.Snapshot, err error) {
+			if err != nil {
+				p.app.log.WithError(err).Warn("failed jumping to the next DJ segment")
+				return
+			}
+
+			delete(p.state.player.ContextMetadata, "interactivity_state")
+			delete(p.state.player.ContextMetadata, "interactivity_response")
+			p.narrationJumped = true
+			p.publishSnapshot(snap)
+			p.state.player.Timestamp = time.Now().UnixMilli()
+			p.state.player.PositionAsOfTimestamp = 0
+			p.loadCurrentTrack(p.state.player.IsPaused, true, true, delay, func(err error) {
+				if err != nil {
+					p.app.log.WithError(err).Warn("failed loading the next DJ segment")
+				}
+			})
+		})
+
+	return nil
+}
diff --git a/daemon/dj_signal.go b/daemon/dj_signal.go
new file mode 100644
index 0000000..18e0dd8
--- /dev/null
+++ b/daemon/dj_signal.go
@@ -0,0 +1,241 @@
+package daemon
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/devgianlu/go-librespot/dealer"
+)
+
+const djPlaylistURI = "spotify:playlist:37i9dQZF1EYkqdzj48dyYq"
+
+// isDJContext reports whether the active context is Spotify DJ.
+func (p *AppPlayer) isDJContext() bool {
+	if p.state.player == nil {
+		return false
+	}
+	uri := p.state.player.ContextUri
+	md := p.state.player.GetContextMetadata()
+	return uri == djPlaylistURI ||
+		strings.HasPrefix(uri, "spotify:lexicon:") ||
+		md["lexicon_set_type"] == "your_dj" ||
+		md["dj.interactivity_enabled"] == "true"
+}
+
+func (p *AppPlayer) djInteractionAvailable() bool {
+	return p.state.active && p.isDJContext()
+}
+
+// ensureDJMetadata sets the metadata the Android client checks before
+// enabling the DJ request button (Lp/rnn1;->u requires lexicon_set_type).
+func (p *AppPlayer) ensureDJMetadata() {
+	if p.state.player.ContextMetadata == nil {
+		p.state.player.ContextMetadata = map[string]string{}
+	}
+	p.state.player.ContextMetadata["lexicon_set_type"] = "your_dj"
+	p.state.player.ContextMetadata["dj.interactivity_enabled"] = "true"
+}
+
+// decodePromptPayload extracts user_prompt (field 1) from a base64
+// PromptSignalPayload protobuf; falls back to the raw string.
+func decodePromptPayload(param string) string {
+	raw, err := base64.StdEncoding.DecodeString(param)
+	if err != nil || len(raw) < 2 || raw[0] != 0x0a {
+		return param
+	}
+	n, i := 0, 1
+	for shift := 0; i < len(raw); shift += 7 {
+		b := raw[i]
+		i++
+		n |= int(b&0x7f) << shift
+		if b < 0x80 {
+			break
+		}
+	}
+	if i+n > len(raw) {
+		return param
+	}
+	return string(raw[i : i+n])
+}
+
+func appendProtoVarint(buf []byte, v uint64) []byte {
+	for v >= 0x80 {
+		buf = append(buf, byte(v)|0x80)
+		v >>= 7
+	}
+	return append(buf, byte(v))
+}
+
+func appendProtoString(buf []byte, fieldNum int, val string) []byte {
+	if val == "" {
+		return buf
+	}
+	buf = appendProtoVarint(buf, uint64(fieldNum<<3|2))
+	buf = appendProtoVarint(buf, uint64(len(val)))
+	return append(buf, val...)
+}
+
+func decodeVarint(b []byte) (uint64, int) {
+	var val uint64
+	for i, c := range b {
+		val |= uint64(c&0x7f) << (i * 7)
+		if c < 0x80 {
+			return val, i + 1
+		}
+	}
+	return 0, 0
+}
+
+func parseDJAckResponse(raw []byte) (sessionID, ackText string) {
+	i := 0
+	for i < len(raw) {
+		tag, n := decodeVarint(raw[i:])
+		if n == 0 {
+			break
+		}
+		i += n
+		fieldNum := tag >> 3
+		wireType := tag & 7
+		switch wireType {
+		case 0:
+			_, n := decodeVarint(raw[i:])
+			if n == 0 {
+				return
+			}
+			i += n
+		case 2:
+			length, n := decodeVarint(raw[i:])
+			if n == 0 || i+n+int(length) > len(raw) {
+				return
+			}
+			i += n
+			val := string(raw[i : i+int(length)])
+			if fieldNum == 4 {
+				ackText = val
+			} else if fieldNum == 7 {
+				sessionID = val
+			}
+			i += int(length)
+		default:
+			return
+		}
+	}
+	return
+}
+
+func (p *AppPlayer) executeDJPrompt(prompt string) {
+	p.djPromptPending = true
+	p.ensureDJMetadata()
+	if p.state.player.ContextMetadata["interactivity_state"] == "" {
+		p.state.player.ContextMetadata["interactivity_state"] = "client-think"
+	}
+	delete(p.state.player.ContextMetadata, "interactivity_response")
+	p.flushState()
+
+	go func() {
+		ctx, cancel := context.WithTimeout(p.ctx, 20*time.Second)
+		defer cancel()
+
+		deviceId := p.app.deviceId
+		currentTrackUri := ""
+		if p.state.player != nil && p.state.player.Track != nil {
+			currentTrackUri = p.state.player.Track.Uri
+		}
+
+		p.app.log.Infof("dispatching DJ prompt to Spotify backend: %q (device=%s track=%s)", prompt, deviceId, currentTrackUri)
+
+		// 1. GetAckCommentaryAndPrepareRecs
+		var req1 []byte
+		req1 = appendProtoString(req1, 1, prompt)
+		req1 = appendProtoString(req1, 3, deviceId)
+		if currentTrackUri != "" {
+			req1 = appendProtoString(req1, 5, currentTrackUri)
+		}
+
+		header := http.Header{
+			"Accept":       []string{"application/x-protobuf"},
+			"Content-Type": []string{"application/x-protobuf"},
+		}
+
+		path1 := "/dj-interaction-manager/spotify.dj.interactionmanager.v0.DJInteractionManagerService/GetAckCommentaryAndPrepareRecs"
+		resp1, err := p.sess.Spclient().Request(ctx, "POST", path1, nil, header, req1)
+		var sessionID, ackText string
+		if err == nil && resp1 != nil {
+			body1, _ := io.ReadAll(resp1.Body)
+			_ = resp1.Body.Close()
+			sessionID, ackText = parseDJAckResponse(body1)
+			p.app.log.Infof("DJ ack commentary received: sessionID=%q ackText=%q", sessionID, ackText)
+		} else {
+			p.app.log.WithError(err).Warn("DJ GetAckCommentary request failed; proceeding to GenerateAndPlayRecs")
+		}
+
+		// 2. GenerateAndPlayRecs
+		var req2 []byte
+		req2 = appendProtoString(req2, 1, prompt)
+		if sessionID != "" {
+			req2 = appendProtoString(req2, 2, sessionID)
+		}
+		req2 = appendProtoString(req2, 3, deviceId)
+		if currentTrackUri != "" {
+			req2 = appendProtoString(req2, 5, currentTrackUri)
+		}
+		if ackText != "" {
+			req2 = appendProtoString(req2, 6, ackText)
+		}
+
+		path2 := "/dj-interaction-manager/spotify.dj.interactionmanager.v0.DJInteractionManagerService/GenerateAndPlayRecs"
+		resp2, err := p.sess.Spclient().Request(ctx, "POST", path2, nil, header, req2)
+		success := false
+		if err == nil && resp2 != nil {
+			_ = resp2.Body.Close()
+			p.app.log.Infof("DJ GenerateAndPlayRecs completed: status=%d", resp2.StatusCode)
+			if resp2.StatusCode == http.StatusOK {
+				success = true
+			}
+		} else {
+			p.app.log.WithError(err).Warn("DJ GenerateAndPlayRecs request failed")
+		}
+
+		select {
+		case p.djPromptDone <- success:
+		case <-p.ctx.Done():
+		}
+	}()
+}
+
+func (p *AppPlayer) handleDJSignal(req dealer.RequestPayload) error {
+	if !p.djInteractionAvailable() {
+		return errors.New("DJ interaction unavailable for the active context")
+	}
+	p.ensureDJMetadata()
+	switch req.Command.SignalID {
+	case "interact":
+		state := req.Command.Parameters
+		if state == "" {
+			state = "listen"
+		}
+		if state != "client-think" && state != "think" {
+			p.djPromptPending = false
+		}
+		p.state.player.ContextMetadata["interactivity_state"] = state
+		delete(p.state.player.ContextMetadata, "interactivity_response")
+		p.flushState()
+		p.app.log.Infof("DJ interaction state: %s", state)
+		return nil
+	case "jump":
+		return p.jumpDJSegment()
+	case "prompt":
+		prompt := decodePromptPayload(req.Command.Parameters)
+		p.app.log.Infof("DJ prompt signal received: %q (raw=%q)", prompt, req.Command.Parameters)
+		p.executeDJPrompt(prompt)
+		return nil
+	default:
+		p.app.log.Infof("unknown DJ signal received: %s params=%q", req.Command.SignalID, req.Command.Parameters)
+		return nil
+	}
+}
